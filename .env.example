# Kopieer naar .env.local en vul in. Nooit echte sleutels in git.
# Supabase-projectadres en publieke (anon/publishable) sleutel: Supabase → Project Settings → API.
# Deze twee waarden zijn bedoeld om in de app te staan; de toegangsregels (RLS) beschermen de gegevens.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Salesforce-domein van ERAForce (optioneel), bv. jouwkantoor.lightning.force.com.
# Daarmee opent de knop "Bel via ERAForce" het record in de Salesforce-app.
VITE_ERAFORCE_DOMEIN=

# Vaste testklok (optioneel). Leeg = testdatum uit de instellingen.
# VITE_TESTDATUM=2026-10-13T07:30

# Alleen voor Edge Functions (fase 4+), NOOIT met VITE_-prefix:
# ANTHROPIC_API_KEY=   → zetten met: supabase secrets set ANTHROPIC_API_KEY=...
